{
  "name": "@sub-store/extensions-repository",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-extension source repository for Sub-Store",
  "repository": {
    "type": "git",
    "url": "https://github.com/dompling/Sub-Store-Extensions.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "extension:list": "node scripts/command.mjs list",
    "extension:create": "node scripts/create-extension.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/command.mjs build",
    "build:frontend": "node scripts/command.mjs build:frontend",
    "build:backend": "node scripts/command.mjs build:backend",
    "typecheck": "node scripts/command.mjs typecheck",
    "package": "node scripts/command.mjs package",
    "package:assemble": "node scripts/command.mjs package:assemble",
    "release:prepare": "node scripts/prepare-release.mjs",
    "repository": "node scripts/command.mjs repository",
    "repository:serve": "node scripts/serve-repository.mjs",
    "source:add": "node scripts/manage-host.mjs source:add",
    "source:refresh": "node scripts/manage-host.mjs source:refresh",
    "extension:install": "node scripts/manage-host.mjs install",
    "extension:install-local": "node scripts/install-local.mjs",
    "install:local": "node scripts/install-local.mjs",
    "verify": "node scripts/command.mjs verify",
    "test": "node scripts/command.mjs test",
    "test:built": "node scripts/command.mjs test:built",
    "check": "node scripts/command.mjs check",
    "host:start": "node scripts/run-host.mjs"
  },
  "devDependencies": {
    "@nutui/nutui": "3.3.8",
    "@vitejs/plugin-vue": "3.2.0",
    "axios": "0.27.2",
    "esbuild": "0.19.8",
    "pinia": "2.3.1",
    "sass": "1.101.0",
    "terser": "5.48.0",
    "typescript": "4.9.5",
    "vite": "3.2.11",
    "vue": "3.5.38",
    "vue-i18n": "9.14.5",
    "vue-router": "4.6.4",
    "vue-tsc": "0.35.2",
    "vuedraggable": "4.1.0"
  }
}
