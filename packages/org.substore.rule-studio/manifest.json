{
  "schemaVersion": 1,
  "id": "org.substore.rule-studio",
  "kind": "executable",
  "distribution": "source-executable",
  "name": "规则集配置",
  "description": "导入、规范化、诊断并发布多客户端规则集",
  "icon": "fa-solid fa-list-check",
  "version": "0.1.5",
  "publisher": {
    "id": "org.substore",
    "name": "Sub-Store"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/dompling/Sub-Store-Extensions",
  "host": {
    "apiVersion": "1.0.0",
    "frontendApiVersion": "1.0.0",
    "backend": ">=2.36.38",
    "implementationAbi": "rule-studio@1",
    "runtimes": [
      "node"
    ]
  },
  "frontend": {
    "entrypoint": "frontend/index.js",
    "style": "frontend/style.css",
    "sdkSpecifier": "@substore/frontend-sdk/v1",
    "uiKitAbi": "substore-ui-kit@1",
    "implementationAbi": "rule-studio-ui@1",
    "routeBase": "/extensions/rule-studio",
    "openPath": "/extensions/rule-studio",
    "assets": {
      "entrypoint": {
        "path": "frontend/index.js",
        "digest": "1c40d1697e28b0b183f24a4feefb28a253f481f47d969f1f043109de7aa2cf20"
      },
      "style": {
        "path": "frontend/style.css",
        "digest": "a5b724b4654dcf62c1fa24cd052b9d931d9958b70d25ef67526600facea89b37"
      }
    }
  },
  "entrypoints": {
    "backend": {
      "path": "backend/index.cjs"
    }
  },
  "variants": {
    "node": {
      "implementationId": "org.substore.rule-studio@1/node",
      "implementationAbi": "rule-studio@1",
      "frontendAssetId": "org.substore.rule-studio-ui@1",
      "entrypoint": "backend/index.cjs",
      "containsExecutableCode": true
    }
  },
  "requires": {
    "hard": [
      "resource-broker@1",
      "artifact-source-registry@1",
      "route-gateway@1"
    ],
    "optional": [
      "reference-graph@1"
    ]
  },
  "permissions": [
    {
      "name": "storage.own",
      "reason": "保存规则集项目、来源和轻量摘要"
    },
    {
      "name": "network.fetch",
      "scope": [
        "user-configured-https",
        "user-configured-http",
        "api.github.com",
        "raw.githubusercontent.com"
      ],
      "reason": "读取用户配置的远程规则集，并索引内置 GitHub 规则库目录"
    },
    {
      "name": "artifact-source.register",
      "scope": [
        "rule-set"
      ],
      "reason": "向资源 Broker 和配置托管提供规则集"
    },
    {
      "name": "references.read-own",
      "scope": [
        "rule-set"
      ],
      "reason": "展示规则集被其他配置引用的数量"
    },
    {
      "name": "routes.namespaced"
    },
    {
      "name": "navigation.register"
    }
  ],
  "contributes": {
    "features": [
      "org.substore.rule-studio.ruleStudio"
    ],
    "routes": [
      "org.substore.rule-studio.list",
      "org.substore.rule-studio.edit",
      "org.substore.rule-studio.preview",
      "org.substore.rule-studio.catalogs",
      "org.substore.rule-studio.download"
    ],
    "artifactSources": [
      {
        "id": "org.substore.rule-studio.rule-sets",
        "type": "rule-set",
        "contract": "substore.rule-set@1",
        "labelKey": "ruleStudio.artifactSource",
        "platforms": [
          "Surge",
          "QX",
          "Clash",
          "Loon"
        ],
        "representations": [
          "normalized-json",
          "surge-rule-list",
          "qx-filter",
          "clash-classical-yaml",
          "clash-classical-text",
          "clash-domain-yaml",
          "clash-ipcidr-yaml",
          "loon-rule-list"
        ]
      }
    ],
    "navigation": [
      "org.substore.rule-studio.main"
    ],
    "pageActions": [
      "org.substore.rule-studio.add",
      "org.substore.rule-studio.catalogs"
    ]
  },
  "storage": {
    "schemaVersion": 3,
    "namespace": "org.substore.rule-studio",
    "legacyKeys": []
  }
}
