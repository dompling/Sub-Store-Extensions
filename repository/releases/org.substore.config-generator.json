            "scope": [
              "rule-set"
            ],
            "reason": "按生成目标生产规则集资源"
          },
          {
            "name": "references.manage-own",
            "scope": [
              "config-project"
            ],
            "reason": "维护配置项目到规则集资源的可修复引用索引"
          },
          {
            "name": "network.fetch",
            "scope": [
              "user-configured-https",
              "user-configured-http"
            ],
            "reason": "读取用户配置的远程订阅和规则集"
          },
          {
            "name": "artifact.produce",
            "scope": [
              "subscription",
              "collection",
              "file",
              "rule"
            ]
          },
          {
            "name": "artifact-source.register",
            "scope": [
              "config-project"
            ]
          },
          {
            "name": "routes.namespaced"
          },
          {
            "name": "navigation.register"
          }
        ],
        "contributes": {
          "features": [
            "org.substore.config-generator.configGenerator"
          ],
          "routes": [
